# statcard — environment variables template.
# Copy this file to .env and fill in your real values:
#   Windows:  copy .env.example .env
#   Unix:     cp .env.example .env
# .env is git-ignored: NEVER commit real keys to the repo.

# --- Required ---------------------------------------------------------------
# HenrikDev API key (free tier): https://dashboard.henrikdev.xyz/
HENRIKDEV_API_KEY=

# --- Optional: web backend --------------------------------------------------
# Shared cache TTL in seconds (default: 3600)
WEB_CACHE_TTL=3600
# Sliding-window rate limits (defaults: 3 per IP and 20 global per minute)
RATE_LIMIT_PER_MIN=3
RATE_LIMIT_GLOBAL_PER_MIN=20
# Comma-separated CORS origins (defaults: local dev + https://statcard.pages.dev)
# ALLOWED_ORIGINS=https://statcard.pages.dev,http://localhost:8080
# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
# LOG_LEVEL=INFO

# --- Optional: cache location ----------------------------------------------
# Overrides the default <repo>/.cache directory
# STATCARD_CACHE_DIR=
